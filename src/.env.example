# 집 / 학교 DB 접속 설정 참고용 파일
# 실제 IP, 계정, 비밀번호는 이 예시 파일에 저장하지 마세요.
# 현재 Java 프로그램은 이 파일을 자동으로 읽지 않습니다.
# 아래에서 사용할 환경의 값을 src/db.properties에 옮겨 적으세요.
# DB_URL -> db.url / DB_ID -> db.id / DB_PASSWORD -> db.pw

# 집: HOME_DB_HOST를 집 PC의 Oracle 리스너 주소로 바꾸세요.
HOME_DB_URL=jdbc:oracle:thin:@HOME_DB_HOST:1521:xe
HOME_DB_ID=YOUR_HOME_DB_USER
HOME_DB_PASSWORD=YOUR_HOME_DB_PASSWORD

# 학교: 학교 PC의 Oracle이 localhost:1521에서 실행되는 경우
SCHOOL_DB_URL=jdbc:oracle:thin:@localhost:1521:xe
SCHOOL_DB_ID=YOUR_SCHOOL_DB_USER
SCHOOL_DB_PASSWORD=YOUR_SCHOOL_DB_PASSWORD

# db.properties 작성 예시 (학교)
# db.url=jdbc:oracle:thin:@localhost:1521:xe
# db.id=실제_학교_DB_계정
# db.pw=실제_학교_DB_비밀번호
